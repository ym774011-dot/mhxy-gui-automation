# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/

# 运行时产物
logs/
debug_batch_glyphs/
debug_capture/
debug_clusters/
debug_glyph_unknowns/
debug_label_me/
debug_unknown_exact/
