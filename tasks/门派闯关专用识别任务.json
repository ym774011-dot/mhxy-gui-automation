{
  "name": "门派闯关专用识别任务（v3 · 整轮自动聚合）",
  "description": "单个 MPCG_auto_round 函数调用即可完成整轮门派闯关：状态轮询→验证码优先暂停避让→三态分发→识别下一门派→瞬移→CALL护法→请出招吧开战→循环至完成弹窗→回城长安(193,125)→(rounds>1)自动接下一轮。无需逐个配置 recognize / teleport_sect / call_guard / goto_city / accept_round。需玩家已从门派闯关使者接取任务（否则脚本等待/提示）。",
  "events": [
    {
      "id": "evt_auto_round",
      "name": "函数调用3",
      "event_type": "function",
      "enabled": true,
      "pre_delay": 0,
      "post_delay": 0.5,
      "on_error": "retry",
      "max_retries": 1,
      "retry_interval": 2.0,
      "params": {
        "module": "MPCG",
        "function": "MPCG_auto_round",
        "kwargs": {
          "timeout": 900,
          "max_steps": 15,
          "rounds": 1,
          "verbose": true
        }
      }
    },
    {
      "id": "evt_check_result",
      "name": "校验本轮结果",
      "event_type": "condition",
      "enabled": true,
      "pre_delay": 0,
      "post_delay": 0,
      "on_error": "skip",
      "params": {
        "variable": "${函数调用3.ok}",
        "operator": "==",
        "value": "true",
        "true_branch": [
          {
            "id": "log_done",
            "name": "完成-打日志",
            "event_type": "log",
            "params": {
              "text": "本轮门派闯关完成：${函数调用3.rounds_done}轮 / 最后${函数调用3.steps}关 / 共${函数调用3.message}"
            }
          }
        ],
        "false_branch": [
          {
            "id": "log_wait",
            "name": "未完成-提示",
            "event_type": "log",
            "params": {
              "text": "本轮未完成：${函数调用3.message}"
            }
          }
        ]
      }
    }
  ]
}