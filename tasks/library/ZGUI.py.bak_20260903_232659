    cx = row["x0"] + random.randint(5, max(1, row["x1"] - row["x0"] - 5))
    cy = row["y0"] + random.randint(2, max(1, row["y1"] - row["y0"] - 2))
    post_click(hwnd, cx, cy, gateway=gateway)
    _sleep(random.uniform(0.5, 0.9))
    return True


